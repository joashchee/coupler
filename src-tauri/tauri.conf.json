{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Coupler",
  "version": "0.26.0",
  "identifier": "com.ansiapps.coupler",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1460",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Coupler",
        "create": false,
        "width": 1280,
        "height": 720,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "backgroundColor": "#0000aa"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "RolePlayingGame",
    "copyright": "ansiapps",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/pocket-tts/": "pocket-tts/"
    }
  }
}
